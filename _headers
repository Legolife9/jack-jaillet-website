# Cloudflare Pages response headers.
#
# The two CSP hashes below cover the only inline blocks on the site:
#   script — the theme bootstrap in each page's <head>
#   style  — the <noscript> reveal fallback
# If you edit either of those snippets (even the whitespace), recompute the
# hash or the browser will silently refuse to run it. Everything else is in
# /css/style.css and /js/main.js, so this should rarely need touching.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-PzBLokaZvNUDewm/MO4NJQlgzvoEq/9WPrbjvKy4Mgc='; connect-src 'self' https://cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com 'sha256-AQw+/rZat5Ptf1TLzB41a0GmKxd3HreJnk3Ip+F7Ou4='; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Images are content-stable but do get replaced occasionally (the logo set was
# swapped once already), so this is a week rather than a year.
/assets/*
  Cache-Control: public, max-age=604800

# No filename hashing on these, so they must revalidate or a CSS fix would
# take a week to reach anyone who had already visited.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Signature Studio (/signatures/) builds email HTML, which is all inline styles,
# and shows images from links people paste, so it needs a looser policy than the
# rest of the site. "! Content-Security-Policy" drops the site-wide one above;
# without it both policies would apply and the stricter one would win.
# No inline scripts and no analytics here. The only outside connection is the
# Supabase project that holds signed-in accounts, and Google's sign-in button
# (accounts.google.com/gsi), which loads only when someone opens the sign-in box.
/signatures/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://rizgpvzmazuvidvbpkoa.supabase.co https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: blob: https:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate
